# DSA Archive — public Firebase WEB identifiers only (never secrets).
# Copy to .env.local, which is gitignored. Rules are the protection.

# Emulator-first development/CI. `true` uses demo-dsa-archive and never
# contacts a live Firebase project.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-dsa-archive
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Owner-provided live web config, for a personally created Spark project.
# Leave empty until the owner completes the phase-2 console checklist.
# These are public identifiers, not credentials; never paste a service key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
