// GENERATED FILE — do not edit by hand.
// Source: tools/generate-firestore-rules.mjs from data/problems.json + data/practice-sets/.
// 20 topics · 495 catalogue ids · 136 synthetic lc-<n> drill keys.
// Rules v6 (phase v2-04): saved solutions in snippets; the notes collection is removed
// (default deny). Prior rules designs are otherwise unchanged.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt',
          'dailyGoal', 'theme', 'hideDone', 'shareSummary', 'friendCode'
        ])
        && data.keys().hasAll([
          'uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt',
          'dailyGoal', 'theme', 'hideDone', 'shareSummary'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.dailyGoal is int
        && data.dailyGoal >= 1
        && data.dailyGoal <= 100
        && data.theme in ['dark', 'light']
        && data.hideDone is bool
        && data.shareSummary is bool
        && (!data.keys().hasAny(['friendCode']) || (data.friendCode is string && data.friendCode.matches('^[a-f0-9]{32}$')));
    }

    function validProfileCreate(data, uid) {
      return validProfile(data, uid) && data.createdAt == request.time;
    }

    function validProfileUpdate(data, old, uid) {
      return validProfile(data, uid) && data.createdAt == old.createdAt;
    }

    function validSummary(data) {
      return data.keys().hasOnly(['displayName', 'solvedCount', 'solvedByTopic', 'currentStreak', 'lastActiveDate', 'weeklySolved', 'asOf'])
        && data.keys().hasAll(['displayName', 'solvedCount', 'solvedByTopic', 'currentStreak', 'lastActiveDate', 'weeklySolved', 'asOf'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.solvedByTopic is map
        && data.solvedByTopic.keys().hasOnly(["beginner-problems", "sorting", "arrays", "hashing", "binary-search", "strings-basic-and-medium", "recursion", "linked-list", "bit-manipulation", "greedy-algorithms", "sliding-window-2-pointer", "stack-queues", "binary-trees", "binary-search-trees", "heaps", "graphs", "dynamic-programming", "tries", "strings-advanced-algo", "maths"])
        && data.solvedByTopic.keys().hasAll(["beginner-problems", "sorting", "arrays", "hashing", "binary-search", "strings-basic-and-medium", "recursion", "linked-list", "bit-manipulation", "greedy-algorithms", "sliding-window-2-pointer", "stack-queues", "binary-trees", "binary-search-trees", "heaps", "graphs", "dynamic-programming", "tries", "strings-advanced-algo", "maths"])
        && data.solvedByTopic["beginner-problems"] is int && data.solvedByTopic["beginner-problems"] >= 0 && data.solvedByTopic["beginner-problems"] <= 83
        && data.solvedByTopic["sorting"] is int && data.solvedByTopic["sorting"] >= 0 && data.solvedByTopic["sorting"] <= 11
        && data.solvedByTopic["arrays"] is int && data.solvedByTopic["arrays"] >= 0 && data.solvedByTopic["arrays"] <= 44
        && data.solvedByTopic["hashing"] is int && data.solvedByTopic["hashing"] >= 0 && data.solvedByTopic["hashing"] <= 10
        && data.solvedByTopic["binary-search"] is int && data.solvedByTopic["binary-search"] >= 0 && data.solvedByTopic["binary-search"] <= 40
        && data.solvedByTopic["strings-basic-and-medium"] is int && data.solvedByTopic["strings-basic-and-medium"] >= 0 && data.solvedByTopic["strings-basic-and-medium"] <= 7
        && data.solvedByTopic["recursion"] is int && data.solvedByTopic["recursion"] >= 0 && data.solvedByTopic["recursion"] <= 30
        && data.solvedByTopic["linked-list"] is int && data.solvedByTopic["linked-list"] >= 0 && data.solvedByTopic["linked-list"] <= 57
        && data.solvedByTopic["bit-manipulation"] is int && data.solvedByTopic["bit-manipulation"] >= 0 && data.solvedByTopic["bit-manipulation"] <= 18
        && data.solvedByTopic["greedy-algorithms"] is int && data.solvedByTopic["greedy-algorithms"] >= 0 && data.solvedByTopic["greedy-algorithms"] <= 18
        && data.solvedByTopic["sliding-window-2-pointer"] is int && data.solvedByTopic["sliding-window-2-pointer"] >= 0 && data.solvedByTopic["sliding-window-2-pointer"] <= 17
        && data.solvedByTopic["stack-queues"] is int && data.solvedByTopic["stack-queues"] >= 0 && data.solvedByTopic["stack-queues"] <= 43
        && data.solvedByTopic["binary-trees"] is int && data.solvedByTopic["binary-trees"] >= 0 && data.solvedByTopic["binary-trees"] <= 44
        && data.solvedByTopic["binary-search-trees"] is int && data.solvedByTopic["binary-search-trees"] >= 0 && data.solvedByTopic["binary-search-trees"] <= 19
        && data.solvedByTopic["heaps"] is int && data.solvedByTopic["heaps"] >= 0 && data.solvedByTopic["heaps"] <= 24
        && data.solvedByTopic["graphs"] is int && data.solvedByTopic["graphs"] >= 0 && data.solvedByTopic["graphs"] <= 66
        && data.solvedByTopic["dynamic-programming"] is int && data.solvedByTopic["dynamic-programming"] >= 0 && data.solvedByTopic["dynamic-programming"] <= 69
        && data.solvedByTopic["tries"] is int && data.solvedByTopic["tries"] >= 0 && data.solvedByTopic["tries"] <= 11
        && data.solvedByTopic["strings-advanced-algo"] is int && data.solvedByTopic["strings-advanced-algo"] >= 0 && data.solvedByTopic["strings-advanced-algo"] <= 13
        && data.solvedByTopic["maths"] is int && data.solvedByTopic["maths"] >= 0 && data.solvedByTopic["maths"] <= 7
        && data.solvedCount is int && data.solvedCount == data.solvedByTopic["beginner-problems"] + data.solvedByTopic["sorting"] + data.solvedByTopic["arrays"] + data.solvedByTopic["hashing"] + data.solvedByTopic["binary-search"] + data.solvedByTopic["strings-basic-and-medium"] + data.solvedByTopic["recursion"] + data.solvedByTopic["linked-list"] + data.solvedByTopic["bit-manipulation"] + data.solvedByTopic["greedy-algorithms"] + data.solvedByTopic["sliding-window-2-pointer"] + data.solvedByTopic["stack-queues"] + data.solvedByTopic["binary-trees"] + data.solvedByTopic["binary-search-trees"] + data.solvedByTopic["heaps"] + data.solvedByTopic["graphs"] + data.solvedByTopic["dynamic-programming"] + data.solvedByTopic["tries"] + data.solvedByTopic["strings-advanced-algo"] + data.solvedByTopic["maths"]
        && data.weeklySolved is int && data.weeklySolved >= 0 && data.weeklySolved <= data.solvedCount
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 100000
        && data.asOf is string && data.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.lastActiveDate == null || (data.lastActiveDate is string && data.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    // Both records must be created in the same atomic batch by the invitee.
    // An owner cannot grant themselves access by inventing a friend record.
    function validFriendCreate(uid, friendUid, data) {
      let invite = get(/databases/$(database)/documents/invites/$(data.code));
      let reciprocal = getAfter(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid));
      return request.auth != null && uid != friendUid
        && (request.auth.uid == uid || request.auth.uid == friendUid)
        && data.keys().hasOnly(['code', 'addedAt']) && data.keys().hasAll(['code', 'addedAt'])
        && data.code is string && data.code.matches('^[a-f0-9]{32}$')
        && data.addedAt == request.time
        && invite.data.uid != request.auth.uid
        && ((invite.data.uid == uid && request.auth.uid == friendUid) || (invite.data.uid == friendUid && request.auth.uid == uid))
        && reciprocal.data.code == data.code && reciprocal.data.addedAt == request.time;
    }

    function canReadSummary(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid)) &&
        exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.shareSummary == true;
    }

    function validCloudEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['s', 'b', 'a', 'fd', 'lr', 'rc', 'o'])
        && entry.keys().hasAll(['s', 'b', 'a', 'fd', 'lr', 'rc'])
        && entry.s in ['todo', 'done', 'revision']
        && entry.b is bool
        && entry.a is int
        && entry.a >= 0
        && entry.a <= 10000
        && entry.rc is int
        && entry.rc >= 0
        && entry.rc <= 100
        && (!entry.keys().hasAny(['o']) || (entry.o in ['clean', 'hint', 'couldnt'] && entry.s != 'todo'))
        && (entry.fd == null || (entry.fd is string && entry.fd.size() <= 40))
        && (entry.lr == null || (entry.lr is string && entry.lr.size() <= 40));
    }

    function validEntryOrDeleted(data, id) {
      return !data.keys().hasAny([id]) || validCloudEntry(data.get(id, {}));
    }

    // Phase v2-04 — one saved solution per problem, created only when written.
    // The doc id is a catalogue slug (synthetic lc-<n> drills match it too);
    // the client only writes known ids and the backup parser re-checks them.
    // Sizes and enums are capped so a hostile client cannot bloat the free
    // tier, and an all-empty snippet must be deleted instead of stored.
    function validSnippet(data) {
      return data.keys().hasOnly(['language', 'code', 'notes', 'verdict', 'updatedAt'])
        && data.keys().hasAll(['language', 'code', 'notes', 'updatedAt'])
        && data.language in ['cpp', 'c', 'java', 'python', 'js', 'ts', 'go', 'rust', 'other']
        && data.code is string
        && data.code.size() <= 8000
        && data.notes is string
        && data.notes.size() <= 500
        && (data.code.size() + data.notes.size()) > 0
        && (!data.keys().hasAny(['verdict']) || data.verdict in ['clean', 'hint', 'couldnt'])
        && data.updatedAt == request.time;
    }

    // Phase 4.1 — one planner document per day. The doc id is a yyyy-mm-dd day
    // key; the lists are bounded and doneIds must stay a subset of
    // problemIds, so a day can never claim work it never planned.
    function validPlan(data, planId) {
      return planId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.keys().hasOnly(['problemIds', 'doneIds', 'updatedAt'])
        && data.keys().hasAll(['problemIds', 'doneIds', 'updatedAt'])
        && data.problemIds is list
        && data.problemIds.size() <= 200
        && data.doneIds is list
        && data.doneIds.size() <= 200
        && data.problemIds.join('').size() <= 12000
        && data.doneIds.join('').size() <= 12000
        && data.doneIds.toSet().difference(data.problemIds.toSet()).size() == 0
        && data.updatedAt == request.time;
    }

    // Phase 3.3 — a custom list: title + problem ids. Lists hold at most 200
    // ids and the joined id text is capped, so one document stays small.
    function validList(data, listId) {
      return listId.matches('^[a-z0-9-]{8,40}$')
        && data.keys().hasOnly(['title', 'problemIds', 'updatedAt'])
        && data.keys().hasAll(['title', 'problemIds', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 60
        && data.problemIds is list
        && data.problemIds.size() <= 200
        && data.problemIds.join('').size() <= 12000
        && data.updatedAt == request.time;
    }

