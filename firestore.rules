    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validProfileCreate(request.resource.data, uid);
      allow update: if isOwner(uid)
        && validProfileUpdate(request.resource.data, resource.data, uid);
      allow delete: if isOwner(uid);

      match /friends/{friendUid} {
        allow get, list: if isOwner(uid);
        allow create: if validFriendCreate(uid, friendUid, request.resource.data);
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      match /public/{summaryId} {
        allow get: if summaryId == 'summary' && (isOwner(uid) || canReadSummary(uid));
        allow create, update: if summaryId == 'summary' && isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.shareSummary == true
          && validSummary(request.resource.data);
        allow delete: if summaryId == 'summary' && isOwner(uid);
      }

      // A collection query must be provably readable for every possible topic
      // id, so get/list lives on the wildcard. Writes only exist for the 20
      // literal catalogue topic blocks below.
      match /progressByTopic/{topicId} {
        allow get, list: if isOwner(uid);
      }

      match /progressByTopic/beginner-problems {
        allow create: if isOwner(uid)
          && validProgressWrite_beginner_problems(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_beginner_problems(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/sorting {
        allow create: if isOwner(uid)
          && validProgressWrite_sorting(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_sorting(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/arrays {
        allow create: if isOwner(uid)
          && validProgressWrite_arrays(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_arrays(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/hashing {
        allow create: if isOwner(uid)
          && validProgressWrite_hashing(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_hashing(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/binary-search {
        allow create: if isOwner(uid)
          && validProgressWrite_binary_search(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_binary_search(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/strings-basic-and-medium {
        allow create: if isOwner(uid)
          && validProgressWrite_strings_basic_and_medium(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_strings_basic_and_medium(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/recursion {
        allow create: if isOwner(uid)
          && validProgressWrite_recursion(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_recursion(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/linked-list {
        allow create: if isOwner(uid)
          && validProgressWrite_linked_list(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_linked_list(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/bit-manipulation {
        allow create: if isOwner(uid)
          && validProgressWrite_bit_manipulation(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_bit_manipulation(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/greedy-algorithms {
        allow create: if isOwner(uid)
          && validProgressWrite_greedy_algorithms(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_greedy_algorithms(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/sliding-window-2-pointer {
        allow create: if isOwner(uid)
          && validProgressWrite_sliding_window_2_pointer(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_sliding_window_2_pointer(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/stack-queues {
        allow create: if isOwner(uid)
          && validProgressWrite_stack_queues(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_stack_queues(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/binary-trees {
        allow create: if isOwner(uid)
          && validProgressWrite_binary_trees(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_binary_trees(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/binary-search-trees {
        allow create: if isOwner(uid)
          && validProgressWrite_binary_search_trees(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_binary_search_trees(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/heaps {
        allow create: if isOwner(uid)
          && validProgressWrite_heaps(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_heaps(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/graphs {
        allow create: if isOwner(uid)
          && validProgressWrite_graphs(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_graphs(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/dynamic-programming {
        allow create: if isOwner(uid)
          && validProgressWrite_dynamic_programming(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_dynamic_programming(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/tries {
        allow create: if isOwner(uid)
          && validProgressWrite_tries(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_tries(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/strings-advanced-algo {
        allow create: if isOwner(uid)
          && validProgressWrite_strings_advanced_algo(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_strings_advanced_algo(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      match /progressByTopic/maths {
        allow create: if isOwner(uid)
          && validProgressWrite_maths(request.resource.data, {});
        allow update: if isOwner(uid)
          && validProgressWrite_maths(request.resource.data, resource.data);
        allow delete: if isOwner(uid);
      }

      // Saved solutions and lists are personal data: own-data-only, one
      // document per write. Snippet ids are catalogue problem slugs; list ids
      // are generated lowercase UUIDs. Snippets are never shared with
      // friends (the v1 privacy rule) — only the owner can reach them.
      match /snippets/{problemId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && problemId.matches('^[a-z0-9][a-z0-9-]{0,79}$')
          && validSnippet(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /lists/{listId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validList(request.resource.data, listId);
        allow delete: if isOwner(uid);
      }

      // Phase 4.1 — the daily planner. One document per local day, owner-only,
      // one document per write; the revision queue and the stats are derived
      // on-device from progress entries and need no collection of their own.
      match /plans/{date} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPlan(request.resource.data, date);
        allow delete: if isOwner(uid);
      }
    }

    // Invite IDs are 128-bit bearer capabilities. Listing and updates are denied.
    match /invites/{code} {
      allow get: if request.auth != null && code.matches('^[a-f0-9]{32}$');
      allow create: if request.auth != null && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Default deny: no other collection/path has an allow rule. Friend
    // paths without an explicit allow remain private.
  }
}
