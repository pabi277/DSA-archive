{
  "name": "dsa-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:emulator": "VITE_FIREBASE_USE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-dsa-archive npm run dev",
    "predev": "node tools/build-runner-worker.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node tools/build-runner-worker.mjs",
    "build:emulator": "VITE_FIREBASE_USE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-dsa-archive npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "node --test tools/firestore-rules.test.mjs",
    "test:emulator": "PLAYWRIGHT_EMULATOR=1 firebase emulators:exec --only auth,firestore --project demo-dsa-archive \"npm run test:rules && npm run test:e2e\"",
    "test:data": "python3 tools/validate_data.py",
    "check:content": "node tools/content-coverage.mjs --check",
    "content:coverage": "node tools/content-coverage.mjs --write",
    "content:seed": "python3 tools/seed_content_phase3.py",
    "check:rules": "node tools/generate-firestore-rules.mjs --check",
    "rules:generate": "node tools/generate-firestore-rules.mjs",
    "pwa:icons": "node tools/generate-pwa-icons.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "check:links": "node tools/check-links.mjs && node tools/check-resource-links.mjs",
    "check:budgets": "node tools/check-budgets.mjs",
    "check:csp": "node tools/check-csp.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:deadweight": "node tools/check-deadweight.mjs",
    "check:hardening": "npm run check:csp && npm run check:tokens && npm run check:deadweight",
    "runtime:worker": "node tools/build-runner-worker.mjs",
    "runtime:fetch": "node tools/fetch-runtime.mjs",
    "runtime:check": "node tools/build-runner-worker.mjs --check && node tools/fetch-runtime.mjs --check",
    "runtime:clean": "node tools/fetch-runtime.mjs --clean"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@live-codes/clang-wasm": "0.3.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
