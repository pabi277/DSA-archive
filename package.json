{
  "name": "dsa-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:emulator": "VITE_FIREBASE_USE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-dsa-archive npm run dev",
    "build": "tsc -b && vite build",
    "build:emulator": "VITE_FIREBASE_USE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-dsa-archive npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "node --test tools/firestore-rules.test.mjs",
    "test:emulator": "PLAYWRIGHT_EMULATOR=1 firebase-tools emulators:exec --only auth,firestore --project demo-dsa-archive \"npm run test:rules && npm run test:e2e\"",
    "test:data": "python3 tools/validate_data.py",
    "check:rules": "node tools/generate-firestore-rules.mjs --check",
    "rules:generate": "node tools/generate-firestore-rules.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "check:links": "node tools/check-links.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.50",
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "firebase-tools": "15.34.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
